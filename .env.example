# ==============================================================================
# Contabo Snapshot Manager - Docker Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Contabo API Credentials (Required)
# ------------------------------------------------------------------------------
# Obtain credentials in your Contabo Customer Control Panel -> API Management
CONTABO_CLIENT_ID=your_client_id_here
CONTABO_CLIENT_SECRET=your_client_secret_here
CONTABO_API_USER=your_email@domain.com
CONTABO_API_PASSWORD=your_api_password_here

# ------------------------------------------------------------------------------
# 2. Ring-Buffer Retention Policy
# ------------------------------------------------------------------------------
# MAX_SNAPSHOTS:
# - 'auto': Automatically detects VPS tier (VPS S=1, VPS M=2, VPS L=3, VPS XL=4)
# - 1, 2, 3, 4: Fixed maximum snapshot count to keep per VPS
MAX_SNAPSHOTS=auto

# Prefix used when creating automated snapshots (e.g. daily, weekly, prod-backup)
SNAPSHOT_NAME=daily

# Snapshot description text stored in Contabo metadata
SNAPSHOT_DESCRIPTION=Automated snapshot by Contabo Snapshot Manager

# ------------------------------------------------------------------------------
# 3. Instance Filtering (Optional)
# ------------------------------------------------------------------------------
# Include only specific instance IDs (comma-separated, leave empty for all)
# INCLUDE_INSTANCES=1001,1002

# Exclude specific instance IDs (comma-separated, leave empty for none)
# EXCLUDE_INSTANCES=9999

# Filter instances by substring in name or displayName (case-insensitive)
# INSTANCE_FILTER=production

# ------------------------------------------------------------------------------
# 4. Execution & Safety Settings
# ------------------------------------------------------------------------------
# Set to 'true' to simulate operations without creating/deleting snapshots
DRY_RUN=false

# Delay (in seconds) after deleting a snapshot before proceeding with creation
WAIT_AFTER_DELETE=5

# ------------------------------------------------------------------------------
# 5. Scheduling & Docker Container Settings
# ------------------------------------------------------------------------------
# Cron schedule expression for container daemon (default: daily at 03:00)
CRON_SCHEDULE=0 3 * * *

# Run an immediate rotation when starting the Docker container
RUN_ON_STARTUP=false

# Timezone for log timestamps and cron scheduler
TZ=Europe/Berlin
